<header class="site-header">
  <a href="/" class="logo">MORE</a>
  <nav class="nav" id="mainNav">
    <a href="/" class="{{ 'active' if activePage == 'home' }}">Home</a>
    <a href="/trabalhos/" class="{{ 'active' if activePage == 'trabalhos' }}">Trabalhos</a>
    <a href="/o-que-fazemos/" class="{{ 'active' if activePage == 'servicos' }}">O que fazemos</a>
    <a href="/sobre/" class="{{ 'active' if activePage == 'about' }}">Sobre</a>
    <a href="/contato/" class="{{ 'active' if activePage == 'contato' }}">Contato</a>
  </nav>
  <button class="nav-toggle" id="navToggle" aria-label="Abrir menu">MENU</button>
</header>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggle = document.getElementById("navToggle");
    const nav = document.getElementById("mainNav");
    toggle.addEventListener("click", () => {
      nav.classList.toggle("open");
      toggle.textContent = nav.classList.contains("open") ? "FECHAR" : "MENU";
    });
  });
</script>
